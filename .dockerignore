# Dependencies (reinstalled inside the image with `npm ci`)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (rebuilt inside the image)
dist
dist-ssr
*.tsbuildinfo

# Git
.git
.gitignore
.gitattributes

# Docs / source maps (not needed at runtime)
*.md
*.map

# Local env & secrets
*.local
.env
.env.*
!.env.example

# Editor & OS junk
.vscode
.idea
*.sw?
.DS_Store
Thumbs.db

# Temp / cache
/tmp
*.tmp
.cache